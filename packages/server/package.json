{
  "name": "@soat/server",
  "version": "0.59.3",
  "private": true,
  "description": "SOAT server — open-source infrastructure for production-ready AI agents.",
  "keywords": [
    "ai-agents",
    "ai-infrastructure",
    "mcp",
    "llm",
    "rag",
    "self-hosted",
    "soat"
  ],
  "homepage": "https://soat.ttoss.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/ttoss/soat",
    "directory": "packages/server"
  },
  "license": "Apache-2.0",
  "main": "dist/server.mjs",
  "scripts": {
    "build": "tsdown",
    "db-dev:logs": "docker compose -f docker-compose.db.yml logs -f",
    "db-dev:rm": "docker compose -f docker-compose.db.yml down -v",
    "db-dev:start": "docker compose -f docker-compose.db.yml up -d",
    "db-dev:stop": "docker compose -f docker-compose.db.yml down",
    "dev": "tsx watch src/server.ts",
    "eval:knowledge": "node tests/eval/runEval.mjs",
    "lint": "pnpm run lint-openapi && eslint src tests",
    "lint-openapi": "spectral lint src/rest/openapi/**/*.yaml",
    "purge-formation-secret-outputs": "tsx scripts/purgeFormationSecretOutputs.ts",
    "queue-soak": "tsx scripts/orchestrationQueueSoak.ts",
    "test": "jest --projects tests/unit",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json"
  },
  "type": "module",
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.82",
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/azure": "^4.0.70",
    "@ai-sdk/google": "^4.0.69",
    "@ai-sdk/google-vertex": "5.0.81",
    "@ai-sdk/groq": "^4.0.41",
    "@ai-sdk/openai": "^4.0.66",
    "@ai-sdk/xai": "^4.0.58",
    "@aws-sdk/client-bedrock": "^3.1131.0",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/client-sqs": "^3.1131.0",
    "@aws-sdk/credential-providers": "^3.1131.0",
    "@soat/postgresdb": "workspace:*",
    "@ttoss/auth-core": "^0.14.1",
    "@ttoss/http-server": "^0.8.1",
    "@ttoss/http-server-auth": "^0.6.4",
    "@ttoss/http-server-mcp": "^0.29.0",
    "@ttoss/http-server-mcp-openapi": "^0.4.0",
    "@ttoss/postgresdb": "^0.12.0",
    "ai": "^7.0.99",
    "ajv": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "croner": "^10.0.1",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.9.1",
    "json-logic-engine": "^5.0.7",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "^6.16.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@ttoss/config": "^1.38.0",
    "@ttoss/test-utils": "^4.2.19",
    "@types/debug": "^4.1.13",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "ajv-formats": "^3.0.1",
    "jest": "^30.5.1",
    "js-yaml": "^5.4.2",
    "supertest": "^7.2.2",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  }
}
