{
  "module": "guardrails",
  "operations": [
    {
      "operationId": "createGuardrail",
      "action": "guardrails:CreateGuardrail",
      "description": "Create a guardrail"
    },
    {
      "operationId": "listGuardrails",
      "action": "guardrails:ListGuardrails",
      "description": "List guardrails in a project"
    },
    {
      "operationId": "getGuardrail",
      "action": "guardrails:GetGuardrail",
      "description": "Get a guardrail by ID"
    },
    {
      "operationId": "updateGuardrail",
      "action": "guardrails:UpdateGuardrail",
      "description": "Update a guardrail"
    },
    {
      "operationId": "deleteGuardrail",
      "action": "guardrails:DeleteGuardrail",
      "description": "Delete a guardrail"
    },
    {
      "operationId": "listGuardrailVersions",
      "action": "guardrails:ListGuardrailVersions",
      "description": "List a guardrail's archived config versions"
    },
    {
      "operationId": "getGuardrailVersion",
      "action": "guardrails:GetGuardrailVersion",
      "description": "Fetch one archived guardrail config version"
    },
    {
      "operationId": "restoreGuardrailVersion",
      "action": "guardrails:RestoreGuardrailVersion",
      "description": "Restore an archived guardrail config as a new version"
    },
    {
      "operationId": "evaluateGuardrail",
      "action": "guardrails:EvaluateGuardrail",
      "description": "Dry-run evaluate a guardrail without executing"
    },
    {
      "operationId": "detachGuardrail",
      "action": "guardrails:DetachGuardrail",
      "description": "Remove a guardrail from a project, agent, or tool guardrail_ids list"
    }
