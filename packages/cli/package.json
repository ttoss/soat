{
  "name": "@soat/cli",
  "version": "0.74.0",
  "description": "CLI for SOAT — open-source infrastructure for production-ready AI agents.",
  "keywords": [
    "ai-agents",
    "ai-infrastructure",
    "mcp",
    "llm",
    "rag",
    "self-hosted",
    "soat"
  ],
  "homepage": "https://soat.ttoss.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/ttoss/soat",
    "directory": "packages/cli"
  },
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "lint": "eslint src tests",
    "test": "jest --config tests/unit/jest.config.ts --coverage=false",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "build": "pnpm generate && tsdown"
  },
  "dependencies": {
    "@inquirer/input": "^5.1.6",
    "@inquirer/password": "^5.2.2",
    "@soat/sdk": "workspace:*",
    "@ttoss/logger": "^0.10.0",
    "commander": "^15.0.0",
    "js-yaml": "^5.4.2"
  },
  "devDependencies": {
    "@ttoss/config": "^1.41.0",
    "@ttoss/openapi-codegen": "^0.6.1",
    "@ttoss/test-utils": "^4.4.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "jest": "^30.5.2",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "soat": "./bin/soat"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
