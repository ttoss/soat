{
  "private": true,
  "name": "@soat/postgresdb",
  "version": "0.75.0",
  "description": "Database models and operations for SOAT packages",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src",
    "sync": "ttoss-postgresdb sync",
    "test": "jest --projects tests/unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ttoss/postgresdb": "^0.14.1",
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@ttoss/config": "^1.41.0",
    "@ttoss/postgresdb-cli": "^0.5.1",
    "@ttoss/test-utils": "^4.4.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "jest": "^30.5.2",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3"
  }
}
